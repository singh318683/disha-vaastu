# Public checkout key. Safe to expose to the browser; the API returns it.
RAZORPAY_KEY_ID=
# Server only. Never put this in the client.
RAZORPAY_KEY_SECRET=
# HMAC secret for the entitlement token stored in the browser.
ENTITLEMENT_SECRET=
# Razorpay plan ids. Yearly plans should include a 7-day trial in the dashboard.
RAZORPAY_PLAN_MONTHLY_INR=
RAZORPAY_PLAN_MONTHLY_USD=
RAZORPAY_PLAN_YEARLY_INR=
RAZORPAY_PLAN_YEARLY_USD=
